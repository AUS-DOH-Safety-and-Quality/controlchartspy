from collections.abc import Callable
from typing import ParamSpec, TypeAlias

_P = ParamSpec("_P")

JSValue: TypeAlias = None | bool | int | float | str | Object

class Object:
    def __call__(self, *args: JSValue) -> JSValue: ...
    def json(self) -> str: ...

class Context:
    def eval(self, code: str) -> JSValue: ...
    def get(self, name: str) -> JSValue: ...
    def add_callable(self, name: str, callback: Callable[_P, object]) -> None: ...

class JSException(Exception): ...
